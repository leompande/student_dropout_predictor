#%%
fig, axes = plt.subplots(2,3, figsize=(13,7))
axes = axes.flatten()
for i,col in enumerate(cat_cols):
    rate  = df.groupby(col)['dropout'].mean().sort_values(ascending=False)*100
    axes[i].bar(rate.index.astype(str), rate.values, color="blue")
